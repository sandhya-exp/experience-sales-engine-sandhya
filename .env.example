# Point this at local Postgres for dev, or a Supabase project's connection
# string in production (Settings -> Database -> Connection string -> URI).
# The data-access layer (src/lib/db.ts) only needs a Postgres connection —
# it does not depend on Supabase-specific APIs, so this swap is a one-line change.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sales_engine

# Session cookie signing secret (P0 simple auth, see src/lib/auth.ts)
SESSION_SECRET=dev-only-change-me

# --- AI Opportunity Intelligence (src/lib/ai/) ----------------------------
# With a key, the three Claude stages (Opportunity Analyst → Solution Context →
# Readiness/Evaluator) run server-side, grounded in the record and the Sales
# Knowledge Base, and the deterministic layer validates every statement.
# Without a key — or if the API fails — the same workflow runs deterministically
# and the brief is labelled "Deterministic". Never exposed to the browser.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# AI_MODE=deterministic   # force the fallback even when a key is present

# --- The agent's outbound email (src/lib/email/provider.ts) ---------------
# The agent drafts customer messages and, for low-risk actions, can send them.
# Left unset, the DEVELOPMENT provider is used: the message is recorded on the
# opportunity and labelled "Recorded — not delivered". Nothing is ever shown as
# "Sent" unless a live provider confirmed it.
#
# To send for real, set all three. Keys stay server-side.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="Experience.com Sales <sales@yourdomain.com>"

# Let low-risk (green) agent actions run without a person by default. Per
# opportunity this is toggled in the workspace and recorded on the timeline;
# yellow and red actions always wait for approval whatever this says.
# AGENT_AUTO_SEND=green

# --- Quotes -----------------------------------------------------------------
# A quote whose overall discount exceeds this percentage needs an admin's
# approval before it can be sent. The only pricing rule in the product.
# QUOTE_DISCOUNT_APPROVAL_PCT=15

# --- Handoff contract (GET /api/handoff/{leadId}) ------------------------
# Continue to Contract records the quote context on the opportunity and marks
# the stage. Whatever picks up contracting reads that context from this API
# (see docs/QUOTE_HANDOFF.md) — nothing has to be running for the handoff
# itself to work. This shared secret is accepted as X-Sales-Engine-Key so a
# server-to-server caller can read it without a browser session.
HANDOFF_API_KEY=dev-sales-engine-handoff-key

# --- Inbound leads from other channels (POST /api/inquiries) -------------
# A website chat agent, partner page or automation can create leads here with
# this key in the X-Inbound-Key header. Same de-dup and AI brief as /inquire.
INBOUND_API_KEY=dev-inbound-lead-key

# --- Discovery-call booking (Talk to Sales confirmation page) --------------
# Real availability comes from Google Calendar free/busy through a service
# account. Without these, the app runs a clearly labelled "Demo availability"
# fallback (business hours minus bookings already in this database) and never
# claims Google is connected.
#
# 1. Google Cloud → IAM → Service Accounts → create one, enable the Google
#    Calendar API, download a JSON key and paste it (raw or base64) here:
GOOGLE_SERVICE_ACCOUNT_JSON=
#    — or split into two variables instead of the JSON:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=sales-engine@<project>.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 2. Each rep shares their Google Calendar with the service account email
#    ("See only free/busy" is enough for availability). The calendar the event
#    is created on needs "Make changes to events".
# 3. Optional but recommended (Google Workspace): domain-wide delegation with the
#    calendar scopes, then set the user to act as — this is what lets Google send
#    invitations to the customer and the rep. Without it the event is created
#    without attendees and the rep sends the invite (the app says so).
# GOOGLE_CALENDAR_IMPERSONATE=sandhya@experience.com
# Rep calendars that count as "the sales team" (default: every app_users email).
# SALES_CALENDARS=sandhya@experience.com,priya@experience.com
# Calendar the discovery-call event is created on (default: the assigned rep's).
# SALES_BOOKING_CALENDAR=sales-team@experience.com
SALES_TIMEZONE=America/New_York
# SALES_HOURS=09:30-17:00
# DISCOVERY_SLOT_MINUTES=30
# SALES_MIN_FREE_REPS=1
# SALES_BOOKING_DAYS=5
# SALES_MIN_NOTICE_HOURS=2

# --- Stage naming ---------------------------------------------------------
# The handoff boundary: the stage an opportunity enters, and who it is handed
# to. Shown in the sidebar, pipeline, header CTA, handoff screen and AI text.
# Defaults to "Ready to Contract" for both; uncomment to change the wording.
# NEXT_PUBLIC_STAGE_NAME=Ready to Contract
# NEXT_PUBLIC_PARTNER_MODULE_NAME=Contract
